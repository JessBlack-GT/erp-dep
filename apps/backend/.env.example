MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
MONGODB_DB_NAME=erp_m03_test
JWT_SECRET=replace_with_secure_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
NODE_ENV=development
PORT=3000
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN_FRONTEND=http://localhost:8081
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
# Set locally to the selected database name only after confirming it is dedicated QA.
M03_QA_DATABASE=
# Optional email transport. Set real values only locally or in Render.
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_APP_URL=https://erp-dep.pages.dev
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
