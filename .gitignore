# ============================================
# ERP-SYSTEM - .gitignore
# ============================================

# Dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Entorno
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Credenciales y secretos
*.pem
*.key
*.secret
credentials.json
service-account.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log

# Build
dist/
build/
out/

# Testing
coverage/
.nyc_output/

# Temporary
tmp/
temp/

# Mobile
android/app/src/main/assets/
ios/
*.xcodeproject.xcworkspace
*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# MongoDB
.mongorc

# Misc
*.pem
!.npmrc
.eslintcache
.prettierignore
*.tgz
.npm
.yarn-integrity
